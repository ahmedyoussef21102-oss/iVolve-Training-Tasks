@Library('ivolve-shared-library') _

pipeline {
    agent {
        label 'rhel-agent'
    }

    environment {
        APP_REPO = 'https://github.com/Ibrahim-Adel15/DemoApp.git'
        GITOPS_REPO = 'https://github.com/ahmedyoussef21102-oss/iVolve-Training-Tasks.git'
        JAVA_HOME = '/home/ahmed-youssef/.local/java/current'
        MAVEN_HOME = '/home/ahmed-youssef/.local/maven'
        PATH = "/home/ahmed-youssef/.local/bin:/home/ahmed-youssef/.local/maven/bin:/home/ahmed-youssef/.local/java/current/bin:${env.PATH}"
    }

    stages {
        stage('1 - Clone Application') {
            steps {
                sh '''
                    set -e
                    rm -rf app
                    git clone --depth 1 "$APP_REPO" app
                    test -f app/Dockerfile
                '''
            }
        }

        stage('2 - Build App and Unit Tests') {
            steps {
                dir('app') {
                    BuildApp()
                }
            }
        }

        stage('3 - Build, Scan and Push Image') {
            steps {
                dir('app') {
                    BuildImage()
                }
            }
        }

        stage('4 - Update GitOps Manifest') {
            steps {
                script {
                    if (!env.IMAGE) {
                        error('BuildImage did not return an image name.')
                    }
                }

                sh '''
                    set -e
                    rm -rf gitops
                    git clone "$GITOPS_REPO" gitops

                    cd gitops
                    git checkout main

                    sed -i "s|image: IMAGE_PLACEHOLDER|image: ${IMAGE}|" \
                        Jenkins/Lab23/k8s/deployment.yaml

                    grep -F "image: ${IMAGE}" \
                        Jenkins/Lab23/k8s/deployment.yaml

                    git config user.name "Jenkins"
                    git config user.email "jenkins@localhost"

                    git add Jenkins/Lab23/k8s/deployment.yaml

                    if git diff --cached --quiet; then
                        echo "No manifest changes to push."
                        exit 0
                    fi

                    git commit -m "Lab23: update application image to ${IMAGE}"
                '''

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        cat > "$WORKSPACE/git-askpass.sh" <<'ASKPASS'
#!/bin/sh
case "$1" in
    *Username*) printf '%s\n' "$GIT_USERNAME" ;;
    *Password*) printf '%s\n' "$GIT_TOKEN" ;;
esac
ASKPASS
                        chmod 700 "$WORKSPACE/git-askpass.sh"

                        cd gitops
                        GIT_ASKPASS="$WORKSPACE/git-askpass.sh" \
                        GIT_TERMINAL_PROMPT=0 \
                            git push origin HEAD:main

                        rm -f "$WORKSPACE/git-askpass.sh"
                    '''
                }
            }
        }
    }

    post {
        always {
            echo 'Lab 23 GitOps pipeline finished.'
            cleanWs()
        }
        success {
            echo 'SUCCESS: Image published and GitOps manifest pushed.'
        }
        failure {
            echo 'FAILED: Check Jenkins Console Output.'
        }
    }
}
